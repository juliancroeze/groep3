<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<AnchorPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.groep3.controller.ProductPopupController"
    prefWidth="600"
    prefHeight="520"
    stylesheets="@css/product-pop.css"
    styleClass="overlay">

    <VBox styleClass="popup-card" spacing="15">

        <!-- TOP: image + info -->
        <HBox spacing="20">

            <!-- Image -->
            <StackPane styleClass="image-box">
                <ImageView fx:id="fruitImage"
                           fitWidth="200"
                           fitHeight="200"
                           preserveRatio="true"/>
            </StackPane>

            <!-- Info -->
            <VBox spacing="6" styleClass="info-box">
                <Label fx:id="fruitName" styleClass="title"/>
                <Label fx:id="fruitPrice" styleClass="price"/>

                <Label fx:id="fruitBoer"/>
                <Label fx:id="fruitOrigin"/>
                <Label fx:id="fruitCategory"/>
                <Label fx:id="fruitType"/>
                <Label fx:id="fruitStock"/>
                <Label fx:id="fruitFarm"/>
                <Label fx:id="fruitRegion"/>
            </VBox>

        </HBox>

        <!-- Description -->
        <Label fx:id="fruitDescription" wrapText="true"/>

        <!-- Farmer message -->
        <VBox spacing="5">
            <Label text="Bericht van de boer:" styleClass="section-title"/>
            <Label fx:id="fruitMessage" wrapText="true"/>
        </VBox>

        <!-- Bottom controls -->
        <VBox spacing="12" alignment="CENTER">

            <HBox spacing="15" alignment="CENTER" styleClass="amount-box">
                <Button fx:id="minusBtn" text="−"/>
                <TextField fx:id="aantalInput" prefWidth="60" alignment="CENTER"/>
                <Button fx:id="plusBtn" text="+"/>
            </HBox>

            <Button fx:id="addToCartBtn" text="In winkelmand" styleClass="primary-btn"/>
            <Button fx:id="closeBtn" text="Sluiten" styleClass="secondary-btn"/>

        </VBox>

    </VBox>
</AnchorPane>
