<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:controller="com.groep3.Controller.OrderScreenController"  xmlns:fx="http://javafx.com/fxml" prefWidth="1280" prefHeight="720">

    <top>
        <HBox spacing="10" style="-fx-background-color: #333; -fx-padding: 10;">
            <!--<Label text="OrderIT!" style="-fx-text-fill: white; -fx-font-size: 18px;"/> -->
                <HBox spacing="10" style="-fx-background-color: #49bd13ff; -fx-padding: 10;">
                    <Label text="OrderIT!" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                </HBox>
            </HBox>
    </top>


    <center>
        <VBox spacing="20" alignment="center" style="-fx-padding: 10;">
            <Label text="Kies een optie:" style="-fx-font-size: 24px;"/>
            <Button text="Afhalen" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 10 20 10 20;"/>
            <Button text="Bezorgen" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 10 20 10 20;"/>
            <Button onAction="#returnToMain" text="Terug" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 10 20 10 20;"/>        
        </VBox>
    </center>

</BorderPane>